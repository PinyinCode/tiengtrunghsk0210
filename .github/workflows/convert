name: Convert Excel to HTML

on:
  push:
    paths:
      - 'data/**'
      - 'scripts/data/**'
      - 'scripts/**/*.py'
      - 'scripts/config.json'
      - 'fix.py'
      - 'patch_buttons.py'
      - 'quick_search.py'
      - 'vocab_premium.py'
      - 'vocab_data/**'
      - 'requirements.txt'
      - '.github/workflows/convert.yml'
  workflow_dispatch:
    inputs:
      ai_limit:
        description: "So tu AI can sinh (0 = bo qua AI)"
        required: false
        default: "50"
      ai_resume:
        description: "Bo qua tu AI da co (1=on, 0=off)"
        required: false
        default: "1"

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: "pages-${{ github.ref }}"
  cancel-in-progress: false

jobs:
  convert:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install openpyxl cn2an pypinyin jieba pandas hanzidentifier cjkradlib openai

      - name: Verify dependencies
        run: |
          python -c "import openpyxl; print('openpyxl', openpyxl.__version__)"
          python -c "import cn2an; print('cn2an', cn2an.__version__)"
          python -c "import pypinyin; print('pypinyin', pypinyin.__version__)"
          python -c "import jieba; print('jieba OK')"
          python -c "import pandas; print('pandas', pandas.__version__)"
          python -c "import openai; print('openai', openai.__version__)"

      - name: Verify vocab modules
        run: |
          if [ -f vocab_premium.py ]; then
            python -c "from vocab_premium import read_vocab_excel, build_vocab_css, build_vocab_tab_html, build_vocab_modal_html, build_vocab_js_override; print('vocab_premium OK')"
          fi
          if [ -d vocab_data ]; then
            python -c "from vocab_data.radicals_db import RADICALS; print('radicals_db', len(RADICALS))" || true
            python -c "from vocab_data.radical_analyzer import get_radical_for_word; print('radical_analyzer OK')" || true
            python -c "from vocab_data.mnemonic_generator import generate_mnemonic; print('mnemonic_generator OK')" || true
          fi

      - name: Verify quick_search module
        run: |
          if [ -f quick_search.py ]; then
            python -c "from quick_search import patch_quick_search; print('quick_search OK')"
          else
            echo "quick_search.py not found, skip"
          fi

      - name: Pre-flight check
        run: python scripts/check.py

      - name: Generate AI mnemonics
        id: ai_gen
        continue-on-error: true
        env:
          DASHSCOPE_API_KEY: ${{ secrets.DASHSCOPE_API_KEY }}
          QWEN_BASE_URL: ${{ secrets.QWEN_BASE_URL }}
          QWEN_MODEL: ${{ secrets.QWEN_MODEL }}
          DEMO_LIMIT: ${{ github.event.inputs.ai_limit || '50' }}
          RESUME: ${{ github.event.inputs.ai_resume || '1' }}
        run: |
          if [ -z "$DASHSCOPE_API_KEY" ]; then
            echo "ai_ran=false" >> $GITHUB_OUTPUT
            exit 0
          fi
          if [ ! -f "vocab_data/ai_mnemonic_generator.py" ]; then
            echo "ai_ran=false" >> $GITHUB_OUTPUT
            exit 0
          fi
          if [ "$DEMO_LIMIT" = "0" ]; then
            echo "ai_ran=false" >> $GITHUB_OUTPUT
            exit 0
          fi
          if [ ! -f "data/tu_vung_hsk.xlsx" ]; then
            echo "ai_ran=false" >> $GITHUB_OUTPUT
            exit 0
          fi
          python vocab_data/ai_mnemonic_generator.py || true
          if [ ! -f "data/ai_mnemonics.json" ]; then
            echo "ai_ran=false" >> $GITHUB_OUTPUT
            exit 0
          fi
          COUNT=$(python -c "import json; print(len(json.load(open('data/ai_mnemonics.json', encoding='utf-8'))))" 2>/dev/null || echo 0)
          echo "ai_ran=true" >> $GITHUB_OUTPUT
          echo "ai_count=$COUNT" >> $GITHUB_OUTPUT

      - name: Run convert script
        run: python scripts/convert.py

      - name: Verify index.html after convert
        run: |
          if [ ! -f index.html ]; then
            echo "index.html not found"
            exit 1
          fi
          SIZE=$(stat -c%s index.html)
          if [ "$SIZE" -lt 500000 ]; then
            echo "index.html too small"
            exit 1
          fi
          for el in RAW_DATA DATASET_REGISTRY FIREBASE_CONFIG CURRENT_DATASET; do
            if grep -q "$el" index.html; then
              echo "OK $el"
            else
              echo "MISSING $el"
              exit 1
            fi
          done
          OPEN_SCRIPT=$(grep -o "<script" index.html | wc -l)
          CLOSE_SCRIPT=$(grep -o "</script>" index.html | wc -l)
          if [ "$OPEN_SCRIPT" -ne "$CLOSE_SCRIPT" ]; then
            echo "script tags mismatch"
            exit 1
          fi

      - name: Verify AI mnemonics file
        id: verify_ai
        run: |
          if [ ! -f "data/ai_mnemonics.json" ]; then
            echo "has_ai=false" >> $GITHUB_OUTPUT
            exit 0
          fi
          COUNT=$(python -c "import json; print(len(json.load(open('data/ai_mnemonics.json', encoding='utf-8'))))" 2>/dev/null || echo 0)
          if [ "$COUNT" -gt 0 ]; then
            echo "has_ai=true" >> $GITHUB_OUTPUT
            echo "ai_count=$COUNT" >> $GITHUB_OUTPUT
          else
            echo "has_ai=false" >> $GITHUB_OUTPUT
          fi

      - name: Clear Python cache
        run: |
          find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
          find . -type f -name "*.pyc" -delete 2>/dev/null || true

      - name: Run fix.py
        run: |
          if [ -f fix.py ]; then
            python fix.py
          else
            echo "no fix.py"
          fi

      - name: Run quick_search.py
        run: |
          if [ -f quick_search.py ]; then
            python quick_search.py
          else
            echo "no quick_search.py"
          fi

      - name: Verify quick_search in index.html
        run: |
          if [ ! -f quick_search.py ]; then
            exit 0
          fi
          if grep -q "QUICK_SEARCH_MODULE_JS" index.html; then
            COUNT=$(grep -o "QUICK_SEARCH_MODULE_JS" index.html | wc -l)
            echo "quick_search JS inject count: $COUNT"
          else
            echo "quick_search JS not found"
          fi
          if grep -q "QUICK_SEARCH_MODULE_CSS" index.html; then
            echo "quick_search CSS OK"
          else
            echo "quick_search CSS not found"
          fi

      - name: Verify AI mnemonics in index.html
        run: |
          if [ "${{ steps.verify_ai.outputs.has_ai }}" != "true" ]; then
            exit 0
          fi
          AI_MARKER_COUNT=$(grep -o 'mnemonic_source":"ai"' index.html | wc -l)
          AI_CONTENT_COUNT=$(grep -o 'Chiet tu' index.html | wc -l)
          if [ "$AI_MARKER_COUNT" -eq 0 ] && [ "$AI_CONTENT_COUNT" -eq 0 ]; then
            echo "no AI mnemonics found in index.html"
            exit 1
          fi
          echo "AI mnemonics OK"

      - name: Verify datasets loaded
        run: |
          if grep -q '"tonghop"' index.html; then
            echo "tonghop OK"
          else
            echo "tonghop MISSING"
            exit 1
          fi
          if grep -q 'FIX.PY: AUTO-FIT LAYOUT' index.html; then
            echo "fix.py CSS OK"
          fi

      - name: Commit and push
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add index.html
          if [ -f "data/ai_mnemonics.json" ]; then
            git add data/ai_mnemonics.json
          fi
          git add -A
          if git diff --quiet && git diff --staged --quiet; then
            echo "no changes"
          else
            AI_COUNT="${{ steps.verify_ai.outputs.ai_count }}"
            QS_TAG=""
            if grep -q "QUICK_SEARCH_MODULE_JS" index.html; then
              QS_TAG=" + QS"
            fi
            git commit -m "Auto convert Excel to HTML (AI: ${AI_COUNT}${QS_TAG}) [skip ci]"
            git pull --rebase origin ${{ github.ref_name }} || true
            git push origin HEAD:${{ github.ref_name }}
          fi

      - name: Prepare Pages artifact
        run: |
          mkdir -p _site
          cp index.html _site/
          [ -d "assets" ] && cp -r assets _site/ || true
          [ -d "static" ] && cp -r static _site/ || true
          [ -f "404.html" ] && cp 404.html _site/ || true
          if [ -f "data/ai_mnemonics.json" ]; then
            mkdir -p _site/data
            cp data/ai_mnemonics.json _site/data/
          fi

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: '_site'

  deploy:
    needs: convert
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Setup Pages
        uses: actions/configure-pages@v4

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
